// go 1.26.0 because the hatchet module requires it (the Hatchet SDK
// declares go 1.26.0); the core module itself stays at go 1.24.0.
go 1.26.0

// ./hatchet is a separate module so an app that never uses Hatchet never
// downloads its SDK.
use (
	.
	// ./admin is a separate module so the admin HTTP API stays opt-in; it
	// needs only the standard library and the core.
	./admin
	// ./bench is a separate module so the benchmark harness and its
	// database drivers never reach a library module's dependencies.
	./bench
	// ./cli is a separate module so the command line client stays
	// stdlib-only: it talks to the admin API over HTTP and imports nothing
	// from the library.
	./cli
	// ./cli/e2e is test-only: it proves the CLI against the real admin
	// handler without the cli module requiring the library.
	./cli/e2e
	// ./examples holds the programs the docs/ guides copy their code from
	// and the doc checkers; a module of its own so their dependencies never
	// reach a library module.
	./examples
	./hatchet
	// ./otel is a separate module so an app without OpenTelemetry never
	// downloads it; it needs only the OpenTelemetry API, and the app brings
	// whichever SDK or exporter it runs.
	./otel
	// ./otel/sdktest is test-only: it proves otel against the OpenTelemetry
	// SDK, so the SDK stays out of the otel module.
	./otel/sdktest
	// ./recorder is a separate module so an app that keeps no run history
	// never compiles it; it needs only the standard library and the core.
	./recorder
	// ./recorder/e2e is test-only: it proves the recorder on every driver
	// and sqlrecorder on every engine, so their clients stay out of the
	// library modules.
	./recorder/e2e
	// ./recorder/sqlrecorder is a separate module so a recorder app that
	// keeps runs in memory or its own store never compiles it; it needs
	// database/sql only, no database driver.
	./recorder/sqlrecorder
	// ./recorder/sqlrecorder/sqlitetest is test-only: it proves sqlrecorder
	// on a real SQLite database, every error path included, so the SQLite
	// driver stays out of the sqlrecorder module.
	./recorder/sqlrecorder/sqlitetest
	// ./redis is a separate module so an app without Redis never downloads
	// go-redis.
	./redis
	// ./sentry is a separate module so an app that does not report to
	// Sentry never downloads sentry-go.
	./sentry
	// ./sqlstore is a separate module so an app without SQL never downloads
	// sqlb; it takes a *sql.DB and a dialect and requires no database
	// driver, so the app brings the one it already uses.
	./sqlstore
	// ./sqlstore/enginetest is test-only: it proves sqlstore, its outbox and
	// pgxtx on SQLite, Postgres and MySQL, so those drivers stay out of the
	// library modules.
	./sqlstore/enginetest
	// ./sqlstore/pgnotify and ./sqlstore/pgxtx are separate modules so only
	// an app that opts into Postgres LISTEN/NOTIFY wake-ups or pgx
	// transactions downloads pgx.
	./sqlstore/pgnotify
	./sqlstore/pgxtx
)
