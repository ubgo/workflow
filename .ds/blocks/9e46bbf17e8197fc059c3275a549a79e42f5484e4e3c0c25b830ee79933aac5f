func (c *Client) OnLifecycle(fn workflow.LifecycleFunc) error {
	if fn == nil {
		return fmt.Errorf("%w: OnLifecycle with a nil func", workflow.ErrInvalid)
	}
	c.mu.Lock()
	defer c.mu.Unlock()
	if c.started {
		return workflow.ErrAlreadyStarted
	}
	c.lifecycle = append(c.lifecycle, fn)
	return nil
}