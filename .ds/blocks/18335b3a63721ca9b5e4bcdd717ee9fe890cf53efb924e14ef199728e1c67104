func (f *Fake) Pause(ctx context.Context, t workflow.PauseTarget) error {
	if err := ctx.Err(); err != nil {
		return err
	}
	if err := workflow.CheckPause(f.caps, t); err != nil {
		return err
	}
	if t.Workflow != "" && f.passes(t.Workflow) {
		return f.Forward.Pause(ctx, t)
	}
	f.mu.Lock()
	defer f.mu.Unlock()
	f.paused[t] = true
	return nil
}