func (c *Client) PendingSignals(ctx context.Context, run workflow.RunID, names []string, limit int) ([]workflow.RunSignal, error) {
	var out []workflow.RunSignal
	err := c.onRef(workflow.RunRef{RunID: run}, func(s Side, b workflow.Client, inner workflow.RunRef) error {
		r, ok := b.(workflow.RunSignalReader)
		if !ok {
			return workflow.Unsupported("PendingSignals", "the "+string(s)+" backend does not implement workflow.RunSignalReader")
		}
		var err error
		out, err = r.PendingSignals(ctx, inner.RunID, names, limit)
		return err
	})
	return out, err
}