apiVersion: batch/v1
kind: CronJob
metadata:
  name: "digest"
spec:
  schedule: "0 0 * * *"
  concurrencyPolicy: Allow
  startingDeadlineSeconds: 60
  suspend: true
  jobTemplate:
    spec:
      template:
        spec:
          restartPolicy: Never
          containers:
            - name: "job"
              image: "app:2"
              args: ["digest"]
